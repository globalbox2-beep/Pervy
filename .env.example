# Bitrix24 webhook URL (получить в настройках: Приложения → Входящий вебхук)
# Формат: https://your-domain.bitrix24.ru/rest/{user_id}/{token}/
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your_token/

# Интервал опроса сделок в секундах (по умолчанию 60)
POLL_INTERVAL_SECONDS=60

# Хост и порт веб-интерфейса
HOST=0.0.0.0
PORT=8000

# Логирование: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Фильтры мониторинга (опционально)
# Стадии сделок для отслеживания (через запятую, пусто = все стадии)
# Пример: NEW,PREPARATION,EXECUTING
DEAL_STAGES_FILTER=

# Ответственные пользователи для мониторинга (ID через запятую, пусто = все)
DEAL_ASSIGNED_FILTER=
